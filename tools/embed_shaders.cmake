# Solace Express - embeds the GLSL sources (src/shaders/*.glsl) as C++ string constants: writes OUT (shaders_gen.h).
# Each file starts with "//! <constant name>" and optional further "//!" lines (documentation, not part of the
# shader); the rest of the file is the shader source, byte for byte (CR stripped). The constant is written as
# adjacent raw-string pieces of at most 15000 bytes (MSVC's limit for one literal is 16380).
#   cmake -DSRC_DIR=src/shaders -DOUT=build/gen/shaders_gen.h -P tools/embed_shaders.cmake
file(GLOB files "${SRC_DIR}/*.glsl")
list(SORT files)
set(gen "// Generated by tools/embed_shaders.cmake from src/shaders/*.glsl - do not edit\n#pragma once\n")
foreach(f ${files})
  file(READ "${f}" src)
  string(REPLACE "\r" "" src "${src}")
  string(REGEX MATCH "^//! ([A-Za-z0-9_]+)" head "${src}")
  if(NOT CMAKE_MATCH_1)
    message(FATAL_ERROR "${f}: the first line must be //! <constant name>")
  endif()
  set(name "${CMAKE_MATCH_1}")
  string(REGEX REPLACE "^(//![^\n]*\n)+" "" src "${src}")
  string(LENGTH "${src}" n)
  string(APPEND gen "static const char* ${name} =")
  set(i 0)
  while(i LESS n)
    string(SUBSTRING "${src}" ${i} 15000 piece)
    string(APPEND gen "\nR\"GLSL(${piece})GLSL\"")
    math(EXPR i "${i} + 15000")
  endwhile()
  if(n EQUAL 0)
    string(APPEND gen " \"\"")
  endif()
  string(APPEND gen ";\n")
endforeach()
# only touch the file when it changes (no needless rebuilds)
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL gen)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${gen}")
